# node / vite
node_modules
dist/
*.tsbuildinfo

# rust / tauri
src-tauri/target/
src-tauri/gen/

# python sidecar
sidecar/.venv/
__pycache__/
*.pyc

# playwright / test artifacts
.playwright-mcp/
fission-*.png
green-select.png

# python venv (any location)
.venv/

# os
.DS_Store

# scratch CAD artifacts: dev test parts, not shipped
src-tauri/*.sindri
src-tauri/*.step
src-tauri/*.stl
src-tauri/*.3mf

# research / experiment shelf: kept out of the repo
proving-ground/

# bundled Python sidecar runtime (built by scripts/build-sidecar-runtime.sh, ~800MB)
src-tauri/sidecar-runtime/

# secrets / local env: never commit
.env
.env.*
*.key
*.pem
*.p12
secrets.*
credentials.*

# editor / IDE
.vscode/
.idea/
*.swp

# --- agent / editor session artifacts -------------------------------------
# This is a public repo: these carry a username, a home-directory layout, or
# tooling config that has nothing to do with SindriCAD. scripts/check-repo-hygiene.sh
# enforces this in CI, because .gitignore alone says nothing about a path that is
# ALREADY tracked (which is how .claude/settings.json got in).
.claude/
.fable/
.cursor/
.aider*
handoff.md
CLAUDE.md
AGENTS.md
