# node / vite
node_modules
dist/
*.tsbuildinfo

# rust / tauri
src-tauri/target/
src-tauri/gen/

# python sidecar
sidecar/.venv/
__pycache__/
*.pyc

# playwright / test artifacts
.playwright-mcp/
fission-*.png
green-select.png

# python venv (any location)
.venv/

# os
.DS_Store

# scratch CAD artifacts: dev test parts, not shipped.
# Repo-WIDE, not just src-tauri/ — this is a public repo, and a stray part file
# anywhere in the tree publishes real geometry and dimensions. Two fixtures are
# deliberate exceptions: one synthetic bench part, and third_party sample models.
# scripts/check-repo-hygiene.sh backstops this by failing CI if a model is ever
# actually tracked (gitignore says nothing about `git add -f`, or a path already
# tracked before the rule existed).
*.sindri
*.step
*.stl
*.3mf
!sidecar/tools/bench/textured_box.sindri
!sidecar/fixtures/asm_*.step
!third_party/opencascade-rs/crates/viewer/models/*.step

# research / experiment shelf: kept out of the repo
proving-ground/

# bundled Python sidecar runtime (built by scripts/build-sidecar-runtime.sh, ~800MB)
src-tauri/sidecar-runtime/

# staged externalBin for the bundle: `sindri-mcp-<target-triple>`, copied out of
# target/release by CI (and by scripts/stage-sindri-mcp.sh locally). A build
# artifact under a name that varies per platform — never commit it.
src-tauri/binaries/

# secrets / local env: never commit
.env
.env.*
*.key
*.pem
*.p12
secrets.*
credentials.*

# editor / IDE
.vscode/
.idea/
*.swp

# --- agent / editor session artifacts -------------------------------------
# This is a public repo: these carry a username, a home-directory layout, or
# tooling config that has nothing to do with SindriCAD. scripts/check-repo-hygiene.sh
# enforces this in CI, because .gitignore alone says nothing about a path that is
# ALREADY tracked (which is how .claude/settings.json got in).
.claude/
.fable/
.cursor/
.aider*
handoff.md
CLAUDE.md
AGENTS.md
